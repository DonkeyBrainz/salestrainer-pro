# Application
APP_NAME=Luxe Sales Coach API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Email domain allowlist (JSON array, empty = allow all)
ALLOWED_EMAIL_DOMAINS=[]

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1024

# GCP / Firestore
GCP_PROJECT_ID=your-project-id
FIRESTORE_DATABASE=(default)

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://aistudio.google.com"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
RATE_LIMIT_GEMINI_REQUESTS_PER_MINUTE=100

# WebSocket
WEBSOCKET_MAX_CONNECTIONS=5
WEBSOCKET_TIMEOUT_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Application
APP_NAME=SalesTrainer Pro API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Email domain allowlist (JSON array, empty = allow all)
ALLOWED_EMAIL_DOMAINS=[]

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_TEMPERATURE=0.7
GEMINI_LIVE_TEMPERATURE=0.5    # lower = tighter persona adherence for live voice
GEMINI_MAX_TOKENS=1024

# OpenAI Realtime (speech-to-speech provider; only needed if LIVE_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_TEMPERATURE=0.8

# Amazon Bedrock — Nova / Voxtral. Requires `uv sync --extra nova` and AWS
# credentials (standard chain: env vars / ~/.aws / instance role) with
# bedrock:InvokeModel* on the models below.
AWS_REGION=us-east-1
# Nova Sonic: speech-to-speech (live voice provider + voice eval suite)
NOVA_SONIC_MODEL=amazon.nova-2-sonic-v1:0
NOVA_SONIC_TEMPERATURE=0.7
# Nova Lite: text (Bedrock Converse) — turn-based eval harness
NOVA_MODEL=amazon.nova-lite-v1:0
NOVA_TEMPERATURE=0.7
# Mistral Voxtral: text (Bedrock Converse) — turn-based eval harness
VOXTRAL_MODEL=mistral.voxtral-small-24b-2507
VOXTRAL_TEMPERATURE=0.7

# Optional explicit AWS credentials (else resolved via the standard AWS chain)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Coach Agent
COACH_MODEL=gemini-3.5-flash

# Live (speech-to-speech) provider selection. Production runs LIVE_PROVIDER=nova
# for latency (see evals/README.md); locally this defaults to gemini, which
# needs no extra install.
LIVE_PROVIDER=gemini
LIVE_PROVIDER_ALLOWLIST=["gemini"]

# Langfuse (LLM tracing; leave blank to run untraced). SDK reads these from the
# environment — get_settings() mirrors them into os.environ.
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# GCP / Firestore
GCP_PROJECT_ID=your-project-id
FIRESTORE_DATABASE=(default)

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://aistudio.google.com"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
RATE_LIMIT_GEMINI_REQUESTS_PER_MINUTE=100

# WebSocket
WEBSOCKET_MAX_CONNECTIONS=5
WEBSOCKET_TIMEOUT_MINUTES=30

# RAG (knowledge retrieval; disabled by default)
RAG_ENABLED=false
RAG_COLLECTION_NAME=knowledge_chunks
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_TOP_K=3
RAG_USE_HYBRID_SEARCH=false
RAG_USE_RERANKING=false
RAG_USE_CONVERSATION_CONTEXT=false
RAG_USE_OBJECTION_LOOKUP=true
RAG_RERANKING_MODEL=gemini-3.5-flash
RAG_RERANKING_INITIAL_K=10
RAG_RERANKING_FINAL_K=3

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
